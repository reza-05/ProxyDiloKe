# ===================================================================
#  .gitignore for PROXY DILO KE? (C++ OOP Project)
# ===================================================================

# Compiled Binaries and Executables
*.exe
*.out
*.app
proxydiloke
proxydiloke.exe

# Intermediate Object Files and Build Directories
*.o
*.obj
obj/
bin/
build/
out/
dist/

# Debugging and Symbol Files
*.dSYM/
*.pdb
*.ilk
*.idb

# Static and Dynamic Libraries
*.a
*.lib
*.so
*.dll
*.dylib

# Runtime Case Archives and Logs (Generated by game runs)
data/case_archive.txt
*.log

# IDE & Editor Configuration Files
# VS Code
.vscode/
# CLion / JetBrains
.idea/
cmake-build-*/
# Visual Studio
.vs/
*.user
*.suo
# Code::Blocks
*.layout
*.depend
# Vim / Emacs temporary files
*.swp
*.swo
*~
.#*

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
